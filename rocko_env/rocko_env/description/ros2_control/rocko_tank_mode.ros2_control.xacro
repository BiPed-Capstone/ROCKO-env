<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rocko_ros2_control" params="name prefix use_mock_hardware">

    <!-- use_mock_hardware:=true  -> the one MockRocko system below.
         use_mock_hardware:=false -> the real motor plugins (what runs on the robot). -->

    <xacro:if value="${use_mock_hardware}">
      <!-- A WIRING CHECK, NOT A SIMULATION: no physics, each velocity command is echoed back as
           that joint's velocity state. Same joint and interface names as the real plugins, so
           rocko_tank_mode_controllers.yaml loads against it unchanged. -->
      <ros2_control name="MockRocko" type="system">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
        </hardware>
        <joint name="left_wheel_joint">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="right_wheel_joint">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>
    </xacro:if>

    <!-- The real hardware, exactly as it was before the mock existed. Not re-indented, so the
         diff shows that nothing inside changed. -->
    <xacro:unless value="${use_mock_hardware}">
    <ros2_control name="LeftDriveMotor" type="actuator">
      <hardware>
        <plugin>rocko_env/Motor12VoltQuadEncoder</plugin>
        <param name="pinNumberSpeed">14</param>
        <param name="pinNumberDirection">10</param>
        <param name="invert">true</param>
      </hardware> 
      <joint name="left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
    <ros2_control name="RightDriveMotor" type="actuator">
      <hardware>
        <plugin>rocko_env/Motor12VoltQuadEncoder</plugin>
        <param name="pinNumberSpeed">13</param>
        <param name="pinNumberDirection">6</param>
        <param name="invert">false</param>
      </hardware>
      <joint name="right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
    </xacro:unless>
  </xacro:macro>

</robot>