# systemd service: start ROCKO's web dashboard (http://<robot-ip>:8080) when the Pi boots.
# A TEMPLATE: pi/install_boot_service.sh fills in the @...@ paths for the user who runs it and
# installs the result as /etc/systemd/system/rocko-dashboard.service. Do not copy this file by hand.
#
# It runs as root, like every ros2 command on the Pi (pi/rocko_run.sh explains why), in the robot's
# ROS_DOMAIN_ID, so it sees whatever launch is running. When a launch also starts a dashboard
# (tank mode does by default), that one finds port 8080 taken and exits cleanly; this one keeps serving.
# Guide: docs/guides/use-the-dashboard.md, "Start it at boot".

[Unit]
Description=ROCKO web dashboard (port 8080)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Root's HOME is /root, so the user's venv and log folder are named explicitly. pi/rocko_run.sh (and the
# pi/rocko_env.sh it sources) read ROCKO_VENV and ROCKO_DOMAIN_ID.
Environment=ROCKO_VENV=@VENV@
# systemd gives a root service no HOME, and ROS's logging needs one: without it rclpy.init() fails with
# "Failed to get logging directory" and the service restarts every 10 s (found in review, 2026-11-22).
Environment=HOME=/root
Environment=ROCKO_DOMAIN_ID=@DOMAIN_ID@
# launch:= and hardware:= say what is NOT known: a boot service cannot know which launch (if any) is
# running. They go into the run.yaml of a recording started from the page.
ExecStart=@REPO@/pi/rocko_run.sh ros2 run rocko_env Dashboard.py --ros-args -p log_root:=@LOG_ROOT@ -p "launch:=unknown (dashboard boot service)" -p hardware:=unknown
# always, not on-failure: if a launch's dashboard held the port first, this one exits cleanly (code 0)
# and must try again, so it takes over once that launch stops. 10 s: how often a waiting service checks
# whether port 8080 has been let go.
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
